NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
POSTGRES_USER=tiny
POSTGRES_PASSWORD=replace-with-local-db-password
POSTGRES_DB=tiny_market
DATABASE_URL=postgresql://tiny:replace-with-url-encoded-db-password@localhost:5432/tiny_market?schema=public
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_MAX_AGE_MS=28800000
TRUST_PROXY=0
PRODUCT_REPORT_THRESHOLD=3
USER_REPORT_THRESHOLD=5
DEMO_INITIAL_BALANCE=100000
UPLOAD_DIR=apps/api/uploads
MAX_UPLOAD_BYTES=5242880
MAX_IMAGE_PIXELS=16000000
ADMIN_USERNAME=admin_user
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_DISPLAY_NAME=관리자
SEED_USER_PASSWORD=replace-with-a-strong-demo-password
LOG_LEVEL=info
