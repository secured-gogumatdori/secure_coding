{
  "name": "@tiny/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_ENV=test LOG_LEVEL=silent vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.8.2",
    "@tiny/shared": "1.0.0",
    "argon2": "0.43.0",
    "connect-pg-simple": "10.0.0",
    "cors": "2.8.5",
    "dotenv": "16.5.0",
    "express": "5.1.0",
    "express-rate-limit": "8.6.0",
    "express-session": "1.19.0",
    "helmet": "8.1.0",
    "multer": "2.2.0",
    "pg": "8.16.0",
    "pino": "9.7.0",
    "pino-http": "10.4.0",
    "sharp": "0.35.3",
    "socket.io": "4.8.1",
    "zod": "3.25.28"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "7.0.3",
    "@types/cors": "2.8.18",
    "@types/express": "5.0.2",
    "@types/express-session": "1.18.1",
    "@types/multer": "1.4.12",
    "@types/node": "22.15.21",
    "@types/pg": "8.15.2",
    "@types/supertest": "6.0.3",
    "prisma": "6.8.2",
    "supertest": "7.1.3",
    "tsx": "4.19.4",
    "vitest": "4.1.10"
  }
}
